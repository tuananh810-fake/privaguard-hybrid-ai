rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures
// for PrivaGuard AI (#BuildHybridAI 2026):
//
// Collection: privaguard_analyses
// Document ID: auto-generated by Firestore (addDoc)
// Access Pattern: Immutable per-user audit snapshots owned by a
//   Firebase Anonymous Auth user (`ownerUid == request.auth.uid`).
//   Client queries MUST filter by `where('ownerUid', '==', auth.uid)`.
// Fields (all required on create; documents are immutable):
//   - ownerUid: string (required, immutable, == request.auth.uid) - Owner Firebase Auth UID
//   - workspaceId: string (required, 1..128 chars) - Browser workspace identifier
//   - task: string (required, 1..40 chars) - Analysis task type
//   - inferenceSource: string (required, enum: 'ON_DEVICE' | 'IN_CLOUD' | 'UNKNOWN') - Execution engine
//   - modelUsed: string (required, 0..100 chars) - Model identifier used for inference
//   - latencyMs: number (int or float, required, 0..600000) - Total inference latency in ms
//   - ttftMs: number (int or float, required, 0..600000) - Time to first token in ms
//   - piiCount: int (required, 0..5000) - Number of PII entities redacted locally
//   - bytesShielded: int (required, 0..1000000) - Bytes of PII shielded from cloud egress
//   - redactedPreview: string (required, 0..500 chars) - Redacted input snippet (0 raw PII)
//   - analysisText: string (required, 0..30000 chars) - Anonymized AI analysis output
//   - createdAt: timestamp (required, immutable, == request.time) - Server creation timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the caller is authenticated (Firebase Anonymous Auth or signed-in user)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated caller owns the existing document
    function isDocOwner() {
      return isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // Verify ownership field matches the authenticated caller on create
    function ownerUidUnchanged() {
      return request.resource.data.ownerUid is string &&
             request.resource.data.ownerUid == request.auth.uid;
    }

    // Validate that the incoming document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate that the incoming document contains all required fields
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that a value is a bounded number (int or float)
    function isValidBoundedNumber(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    // Validate that a value is a bounded integer
    function isValidBoundedInt(val, minVal, maxVal) {
      return val is int && val >= minVal && val <= maxVal;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidAnalysis(data) {
      let allowedFields = [
        'ownerUid',
        'workspaceId',
        'task',
        'inferenceSource',
        'modelUsed',
        'latencyMs',
        'ttftMs',
        'piiCount',
        'bytesShielded',
        'redactedPreview',
        'analysisText',
        'createdAt'
      ];

      return hasOnlyAllowedFields(allowedFields) &&
             hasRequiredFields(allowedFields) &&
             ownerUidUnchanged() &&
             data.workspaceId is string &&
             data.workspaceId.size() > 0 &&
             data.workspaceId.size() <= 128 &&
             data.task is string &&
             data.task.size() > 0 &&
             data.task.size() <= 40 &&
             data.inferenceSource is string &&
             data.inferenceSource in ['ON_DEVICE', 'IN_CLOUD', 'UNKNOWN'] &&
             data.modelUsed is string &&
             data.modelUsed.size() <= 100 &&
             isValidBoundedNumber(data.latencyMs, 0, 600000) &&
             isValidBoundedNumber(data.ttftMs, 0, 600000) &&
             isValidBoundedInt(data.piiCount, 0, 5000) &&
             isValidBoundedInt(data.bytesShielded, 0, 1000000) &&
             data.redactedPreview is string &&
             data.redactedPreview.size() <= 500 &&
             data.analysisText is string &&
             data.analysisText.size() <= 30000 &&
             data.createdAt is timestamp &&
             data.createdAt == request.time;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /privaguard_analyses/{docId} {
      // Strictly owner-only read (covers both get and list queries filtered by ownerUid)
      allow read: if isDocOwner();

      // Strictly owner-only create with full schema, type, enum, timestamp, and DoS size checks
      allow create: if isAuthenticated() && isValidAnalysis(request.resource.data);

      // Saved analysis reports are immutable audit snapshots
      allow update: if false;

      // Strictly owner-only delete
      allow delete: if isDocOwner();
    }

    // ===============================================================
    // Default Deny
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
